{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "onPoint",
  "version": "0.2.4",
  "identifier": "com.moonlight.onPoint",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "onPoint",
        "width": 600,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "DSOP",
    "category": "Utility",
    "shortDescription": "Gerenciamento de ponto e frequência",
    "longDescription": "onPoint — controle de jornada e frequência com tray integrado e persistência local.",
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
