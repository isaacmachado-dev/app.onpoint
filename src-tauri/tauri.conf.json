{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "onPoint",
  "mainBinaryName": "onPoint",
  "version": "0.3.1",
  "identifier": "com.moonlight.onPoint",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "onPoint",
        "width": 600,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Isaac Machado <contato@isaacmachado.com.br>",
    "category": "Utility",
    "copyright": "Copyright (c) 2026 Isaac Machado (https://isaacmachado.com.br)",
    "homepage": "https://isaacmachado.com.br",
    "license": "Proprietary",
    "shortDescription": "Gerenciamento de ponto e frequencia",
    "longDescription": "onPoint - controle de jornada e frequencia com tray integrado e persistencia local.",
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "files": {
          "/usr/share/metainfo/com.moonlight.onPoint.metainfo.xml": "bundle/com.moonlight.onPoint.metainfo.xml"
        }
      }
    },
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwNzAwQkIyQjU0QjE2MwpSV1Jqc1ZRcnV3QUhCOURpVUJTVEJGZmhCY3JLcFc5bEhONmJtcGUwK3JJZC9idUp6bDJGQVQyWQo=",
      "endpoints": [
        "https://github.com/isaacmachado-dev/app.onpoint/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
